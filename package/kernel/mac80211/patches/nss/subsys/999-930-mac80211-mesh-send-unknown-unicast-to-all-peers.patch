 	hdrlen = ieee80211_hdrlen(hdr->frame_control);
@@ -218,6 +216,15 @@
 		memcpy(mshdr->eaddr1, hdr->addr3, ETH_ALEN);
 		memcpy(mshdr->eaddr2, hdr->addr4, ETH_ALEN);
