+
+static void prepare_for_gate(struct sk_buff *skb, char *dst_addr,
+			     struct mesh_path *gate_mpath)
+{
+	struct ieee80211_hdr *hdr;
+	char *next_hop;
+
+	mesh_frame_add_ae(skb);
 
 	/* update next hop */
 	hdr = (struct ieee80211_hdr *) skb->data;
@@ -1131,6 +1138,90 @@
 	return (from_mpath == mpath) ? -EHOSTUNREACH : 0;
 }
 
+static void prepare_for_peer(struct sk_buff *skb, struct sta_info *peer)
+{
+	struct ieee80211_hdr *hdr;
+
+	mesh_frame_add_ae(skb);
+
+	hdr = (struct ieee80211_hdr *) skb->data;
+	memcpy(hdr->addr1, peer->sta.addr, ETH_ALEN);
+	memcpy(hdr->addr2, peer->sdata->vif.addr, ETH_ALEN);
+	memcpy(hdr->addr3, peer->sta.addr, ETH_ALEN);
+	ieee80211_mps_set_frame_flags(peer->sdata, peer, hdr);
+}
+
+/**
+ * mesh_path_send_to_peers - send a frame for an unknown destination to all peers
+ *
+ * @sdata: network subif the frame will be sent through
+ * @skb: 802.11 frame to be sent
+ *
+ * Without mesh forwarding every mesh node is a peer, so a destination that
+ * is not a peer and has no proxy entry is a station behind one of the peers.
+ * Path discovery can never find it.  Give each established peer a copy
+ * addressed to that peer, with the real destination in the Address
+ * Extension field, the way frames are handed to mesh gates.  The peer that
+ * owns the station bridges it there, and the reply creates the proxy entry.
+ *
+ * Returns: 0 if the frame was queued for the peers, -ENOENT if the
+ * destination is a peer, there is no peer, or the copies could not be made.
+ * The frame is left untouched in that case.
+ */
+int mesh_path_send_to_peers(struct ieee80211_sub_if_data *sdata,
+			    struct sk_buff *skb)
+{
+	struct ieee80211_local *local = sdata->local;
+	struct ieee80211_hdr *hdr = (struct ieee80211_hdr *) skb->data;
+	int headroom = local->tx_headroom + IEEE80211_ENCRYPT_HEADROOM +
+		       2 * ETH_ALEN;
+	struct sta_info *sta, *last_peer = NULL;
+	struct sk_buff_head frames;
+	struct sk_buff *copy;
+
+	skb_queue_head_init(&frames);
+
+	rcu_read_lock();
+	if (sta_info_get(sdata, hdr->addr3))
+		goto fail;
+
+	list_for_each_entry_rcu(sta, &local->sta_list, list) {
+		if (sta->sdata != sdata ||
+		    sta->mesh->plink_state != NL80211_PLINK_ESTAB)
+			continue;
+
+		if (last_peer) {
+			copy = skb_copy_expand(skb, headroom, skb_tailroom(skb),
+					       GFP_ATOMIC);
+			if (!copy)
+				goto fail;
+			prepare_for_peer(copy, last_peer);
+			__skb_queue_tail(&frames, copy);
+		}
+		last_peer = sta;
+	}
+
+	if (!last_peer)
+		goto fail;
+
+	mpath_dbg(sdata, "Sending frame for %pM to %d peers\n",
+		  hdr->addr3, skb_queue_len(&frames) + 1);
+	if (skb_cow_head(skb, headroom))
+		goto fail;
+
+	prepare_for_peer(skb, last_peer);
+	__skb_queue_tail(&frames, skb);
+	rcu_read_unlock();
+
+	ieee80211_add_pending_skbs(local, &frames);
+	return 0;
+
+fail:
+	rcu_read_unlock();
+	__skb_queue_purge(&frames);
+	return -ENOENT;
+}
+
